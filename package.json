{
  "name": "swarm-node",
  "version": "0.2.0-testnet.1",
  "description": "SWARM Node \u00e2\u20ac\u201d run a full node of the SWARM testnet and mine with one click. Consent-first, one-click stop, nothing runs hidden.",
  "main": "electron/main.js",
  "author": "SWARM <swarmofficial@atomicmail.io>",
  "homepage": "https://swarm.green",
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run lint && npm test",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "dist": "npm run build:ui && electron-builder --win",
    "binaries:manifest": "node scripts/make-binaries-manifest.mjs",
    "integration": "node scripts/integration-headless.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "green.swarm.node",
    "productName": "SWARM Node",
    "artifactName": "SWARM-Node-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright (c) 2026 SWARM. MIT licence.",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SWARM Node",
      "uninstallDisplayName": "SWARM Node (SWARM testnet)",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "electron/resources/**"
    ]
  }
}
