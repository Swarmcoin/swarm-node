{
  "name": "swarm-node",
  "version": "0.2.0-testnet.8",
  "description": "SWARM Node \u00e2\u20ac\u201d run a full node of the SWARM testnet and mine with one click. Consent-first, one-click stop, nothing runs hidden.",
  "main": "electron/main.js",
  "author": "SWARM <swarmofficial@atomicmail.io>",
  "homepage": "https://swarm.green",
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run lint && npm run sweep && npm test",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "dist": "npm run build:ui && electron-builder --win",
    "binaries:manifest": "node scripts/make-binaries-manifest.mjs",
    "integration": "node scripts/integration-headless.mjs",
    "sweep": "node scripts/string-sweep.mjs",
    "capture": "node scripts/capture-packaged.mjs",
    "dist:linux": "npm run build:ui && electron-builder --linux",
    "dist:mac": "npm run build:ui && electron-builder --mac",
    "binaries:mainnet": "node scripts/fetch-pinned-binaries.mjs --profile swarm-mainnet",
    "mainnet:embed": "node scripts/embed-network.mjs D:/privacy/network/swarm-mainnet",
    "mainnet:build": "npm run mainnet:embed && npm run check && npm run build:ui && electron-builder --publish never"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "green.swarm.node",
    "productName": "SWARM Node",
    "artifactName": "SWARM-Node-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright (c) 2026 SWARM. MIT licence.",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SWARM Node",
      "uninstallDisplayName": "SWARM Node (SWARM testnet)",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "electron/resources/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "synopsis": "Run a full node of the SWARM testnet and mine with one click",
      "description": "SWARM Node keeps its own copy of the SWARM testnet chain, checks every block for itself, and mines with your processor when you press Start. Rewards are paid by the protocol straight to an address you paste from the SWARM Wallet. There is no account and no key in this app.",
      "icon": "build/icons",
      "executableArgs": []
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "SWARM Node ${version}"
    }
  }
}
